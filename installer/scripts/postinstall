#!/bin/bash
# Runs after Parallax-Installer.pkg copies the plug-in: clear the download quarantine and
# re-apply the local signature so macOS lets Ableton Live load it.
P="/Library/Audio/Plug-Ins/VST3/Parallax.vst3"
if [ -d "$P" ]; then
    /usr/bin/xattr -cr "$P" || true
    /usr/bin/codesign --force --deep --sign - "$P" || true
fi
exit 0
